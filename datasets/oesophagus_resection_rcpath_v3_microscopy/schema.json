{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCPath Oesophageal Carcinoma Resection (Microscopy-only) – Appendix G derived + local fields",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "string",
      "const": "oesophagus_resection_rcpath_v3_microscopy"
    },
    "tumour_type": {
      "type": "string",
      "enum": [
        "Squamous carcinoma",
        "Adenocarcinoma",
        "Other"
      ],
      "default": "Adenocarcinoma"
    },
    "tumour_type_other_specify": {
      "type": "string",
      "default": ""
    },
    "who_adenocarcinoma_subtype": {
      "type": "string",
      "enum": [
        "Tubular",
        "Papillary",
        "Mucinous",
        "Poorly cohesive (including signet ring cell type)",
        "Mixed",
        "Other"
      ],
      "default": "Tubular"
    },
    "who_adenocarcinoma_subtype_other_specify": {
      "type": "string",
      "default": ""
    },
    "differentiation": {
      "type": "string",
      "enum": [
        "Well",
        "Moderate",
        "Poor",
        "Not applicable"
      ],
      "default": "Moderate"
    },
    "depth_of_invasion_phrase": {
      "type": "string",
      "default": ""
    },
    "depth_of_invasion_category": {
      "type": "string",
      "enum": [
        "No tumour identified",
        "High-grade dysplasia",
        "Invasion of lamina propria",
        "Invasion of submucosa",
        "Invasion of muscularis propria",
        "Invasion beyond muscularis propria",
        "Invades pleura, pericardium or diaphragm",
        "Invades aorta, vertebrae or trachea"
      ],
      "default": "Invasion beyond muscularis propria"
    },
    "serosal_involvement": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "default": "No"
    },
    "neoadjuvant_therapy_history": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "default": "No"
    },
    "tumour_regression_system": {
      "type": "string",
      "enum": [
        "Mandard",
        "Other",
        ""
      ],
      "default": "Mandard"
    },
    "tumour_regression_grade": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        1,
        2,
        3,
        4,
        5,
        null
      ],
      "default": null,
      "description": "If Mandard: TRG 1–5"
    },
    "proximal_margin": {
      "type": "string",
      "enum": [
        "Normal",
        "Barrett’s",
        "Dysplasia",
        "Carcinoma"
      ],
      "default": "Normal"
    },
    "distal_margin": {
      "type": "string",
      "enum": [
        "Normal",
        "Dysplasia",
        "Carcinoma"
      ],
      "default": "Normal"
    },
    "circumferential_margin_status": {
      "type": "string",
      "enum": [
        "Involved: carcinoma within 1 mm of CRM",
        "Not involved: carcinoma more than 1 mm from CRM",
        "Not applicable"
      ],
      "default": "Not involved: carcinoma more than 1 mm from CRM"
    },
    "distance_to_crm_mm": {
      "type": "number",
      "minimum": 0,
      "default": 2.0,
      "description": "LOCAL: always record an actual distance (mm), even if CRM involved."
    },
    "positive_crm_location": {
      "type": "string",
      "default": "",
      "description": "LOCAL: If CRM is involved (<1 mm), record the location of positive CRM."
    },
    "lvi": {
      "type": "string",
      "enum": [
        "Present",
        "Not identified"
      ],
      "default": "Not identified"
    },
    "pni": {
      "type": "string",
      "enum": [
        "Present",
        "Not identified"
      ],
      "default": "Not identified"
    },
    "nodes_examined": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "nodes_positive": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "positive_node_stations": {
      "type": "string",
      "default": "",
      "description": "LOCAL: If nodes positive, record station(s) e.g. para-oesophageal, junctional, lesser curve, greater curve."
    },
    "pm1_disease": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "default": "No"
    },
    "tnm_edition": {
      "type": "string",
      "enum": [
        "9"
      ],
      "default": "9"
    },
    "pT": {
      "type": "string",
      "enum": [
        "TX",
        "T0",
        "Tis",
        "T1a",
        "T1b",
        "T2",
        "T3",
        "T4a",
        "T4b",
        "yTX",
        "yT0",
        "yTis",
        "yT1a",
        "yT1b",
        "yT2",
        "yT3",
        "yT4a",
        "yT4b"
      ],
      "default": "T3",
      "description": "May be derived from depth_of_invasion_category/phrase."
    },
    "pN": {
      "type": "string",
      "enum": [
        "NX",
        "N0",
        "N1",
        "N2",
        "N3"
      ],
      "default": "N0"
    },
    "pM": {
      "type": "string",
      "enum": [
        "Not applicable",
        "M1"
      ],
      "default": "Not applicable"
    },
    "y_prefix": {
      "type": "boolean",
      "default": false,
      "description": "If true, use yTNM categories."
    },
    "tumour_block": {
      "type": "string",
      "default": ""
    },
    "comment": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "tumour_type",
    "differentiation",
    "depth_of_invasion_category",
    "serosal_involvement",
    "neoadjuvant_therapy_history",
    "proximal_margin",
    "distal_margin",
    "circumferential_margin_status",
    "distance_to_crm_mm",
    "lvi",
    "pni",
    "nodes_examined",
    "nodes_positive",
    "pm1_disease",
    "tnm_edition"
  ],
  "additionalProperties": false
}
