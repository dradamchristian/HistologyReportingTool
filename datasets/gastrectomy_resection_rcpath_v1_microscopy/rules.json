{
  "dataset_id": "gastrectomy_resection_rcpath_v1_1_microscopy",
  "defaults_policy": "If not mentioned in dictation, default to the schema defaults for report_text. Do not print 'not stated' or 'derived from' in report_text. Provide a separate 'CAVEATS' list of any fields that were defaulted or inferred.",
  "pt_mapping": [
    {
      "match_any": [
        "no tumour"
      ],
      "set": "T0"
    },
    {
      "match_any": [
        "high-grade dysplasia",
        "in situ"
      ],
      "set": "Tis"
    },
    {
      "match_any": [
        "lamina propria"
      ],
      "set": "T1a"
    },
    {
      "match_any": [
        "submucosa"
      ],
      "set": "T1b"
    },
    {
      "match_any": [
        "mucosa"
      ],
      "set": "T1"
    },
    {
      "match_any": [
        "muscularis propria"
      ],
      "set": "T2"
    },
    {
      "match_any": [
        "beyond muscularis propria",
        "through muscularis propria",
        "through the wall",
        "invades through the wall",
        "transmural"
      ],
      "set": "T3"
    },
    {
      "match_any": [
        "serosa",
        "serosal",
        "penetrates serosa",
        "invades the serosa",
        "visceral peritoneum"
      ],
      "set": "T4a"
    },
    {
      "match_any": [
        "adjacent structures",
        "invades spleen",
        "invades transverse colon",
        "invades liver",
        "invades pancreas",
        "invades diaphragm",
        "invades adrenal",
        "invades kidney"
      ],
      "set": "T4b"
    }
  ],
  "pn_mapping_by_positive_nodes": [
    {
      "min": 0,
      "max": 0,
      "set": "N0"
    },
    {
      "min": 1,
      "max": 2,
      "set": "N1"
    },
    {
      "min": 3,
      "max": 6,
      "set": "N2"
    },
    {
      "min": 7,
      "max": 15,
      "set": "N3a"
    },
    {
      "min": 16,
      "max": 9999,
      "set": "N3b"
    }
  ],
  "mandard_descriptors": {
    "1": "TRG 1: Complete regression (no residual tumour; fibrosis may extend through wall).",
    "2": "TRG 2: Rare residual tumour cells scattered through fibrosis.",
    "3": "TRG 3: Residual tumour present, but fibrosis predominates.",
    "4": "TRG 4: Residual tumour outgrowing fibrosis.",
    "5": "TRG 5: No regressive changes."
  },
"r_status_rules": {
  "R1_if_any": [
    { "field": "proximal_margin", "equals": "Involved" },
    { "field": "distal_margin", "equals": "Involved" },
    { "field": "circumferential_margin_status", "contains": "Involved" }
  ]
}
}
